{
  "name": "nodejs-starter-code",
  "displayName": "NodeJS Boilerplate Code Generator",
  "description": "Save time and generate nodejs boiler plate code and folder structure within a single command",
  "version": "0.0.1",
  "publisher": "isudiptodas",
  "icon": "src/images/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/isudiptodas/NodeJS-Starter-Boilercode-Extension"
  },
  "engines": {
    "vscode": "^1.120.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "nodejs-starter-code.createNodeStructure",
        "title": "nodejs boilerplate code"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.19",
    "@types/vscode": "^1.120.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  }
}